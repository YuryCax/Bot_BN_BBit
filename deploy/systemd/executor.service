[Unit]
Description=Bot Executor (Singapore)
After=network.target

[Service]
Type=simple
User=bot
WorkingDirectory=/opt/bot
Environment=BOT_CONFIG=/etc/bot/config.toml
Environment=BOT_SYMBOLS=/etc/bot/symbols.toml
Environment=BOT_ZENOH_CONFIG=/etc/bot/zenoh.json5
Environment=BYBIT_TESTNET=1
Environment=BOT_TESTNET_ANALYTICS=1
Environment=BOT_LEDGER=/var/log/bot/work_ledger.jsonl
Environment=BOT_PACKET_LOG=/var/log/bot/work_packets.bin
Environment=BOT_STATUS_PATH=/var/log/bot/runtime_status.json
Environment=BOT_CAPITAL_PATH=/var/log/bot/capital_policy.json
EnvironmentFile=-/etc/bot/secrets.env
ExecStart=/opt/bot/bin/executor
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
