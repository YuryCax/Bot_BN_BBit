[Unit]
Description=Bot Executor (Singapore)
After=network.target

[Service]
Type=simple
User=bot
WorkingDirectory=/opt/bot
EnvironmentFile=-/etc/bot/secrets.env
Environment=BOT_CONFIG=/etc/bot/config.toml
Environment=BOT_SYMBOLS=/etc/bot/symbols.toml
Environment=BOT_ZENOH_CONFIG=/etc/bot/zenoh.json5
Environment=BOT_LEDGER=/var/log/bot/paper_ledger.jsonl
Environment=BOT_PACKET_LOG=/var/log/bot/packets.bin
ExecStart=/opt/bot/bin/executor
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
