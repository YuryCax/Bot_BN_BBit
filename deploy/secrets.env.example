# Copy to /etc/bot/secrets.env (chmod 600). Never commit real values.
# Used by systemd EnvironmentFile=-/etc/bot/secrets.env

BYBIT_API_KEY=
BYBIT_API_SECRET=
# 1 = testnet REST+prefer testnet habits; 0 = mainnet (only after staged live gates)
BYBIT_TESTNET=1

# Optional: override Bybit public linear WS (default mainnet; set testnet WS when BYBIT_TESTNET=1)
# BYBIT_WS_URL=wss://stream-testnet.bybit.com/v5/public/linear

PANEL_JWT_SECRET=change-me-long-random
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dual-node Zenoh (absolute path on each host)
# BOT_ZENOH_CONFIG=/etc/bot/zenoh.json5
