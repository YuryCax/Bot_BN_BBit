# Local secrets — copy to secrets.env in repo root (gitignored).
# PowerShell:  Copy-Item secrets.env.example secrets.env
#             .\scripts\Import-BotSecrets.ps1
# Linux/AWS:  install as /etc/bot/secrets.env (chmod 600)
#
# NEVER commit secrets.env / .env / real keys.

# --- Bybit (Singapore executor; testnet first) ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=1
# Auto-used when BYBIT_TESTNET=1; override only if needed:
# BYBIT_WS_URL=wss://stream-testnet.bybit.com/v5/public/linear

# Binance: market WS remains public; these read-only keys are used by the
# authenticated connectivity smoke. Keep every trading permission disabled.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# BINANCE_API_BASE=https://api.binance.com

# Control panel (set auth_mode=jwt in config when deploying)
PANEL_JWT_SECRET=change-me-long-random

# Telegram operator bridge
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dual-node (set on each host after copying zenoh json5)
# BOT_ZENOH_CONFIG=/etc/bot/zenoh.json5
